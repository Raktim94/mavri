# Mavri settings. After editing, run: sudo systemctl restart mavri
# Port on this machine that serves Mavri.
HOST_PORT=3001
# Set true when Mavri is served over HTTPS.
COOKIE_SECURE=false
# Set 1 when a reverse proxy (nginx, Caddy, Cloudflare Tunnel) is in front.
TRUST_PROXY=0
# Optional: 32 random bytes in base64 (openssl rand -base64 32). Without it one
# is generated inside the data volume.
ENCRYPTION_KEY=
# Set off to disable the optional version check to GitHub.
UPDATE_CHECK=on
