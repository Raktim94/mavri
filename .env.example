# NodeDR Invoice — Environment Variables
# Copy this file to .env and adjust values as needed.

# Port the frontend is exposed on (default: 3001)
HOST_PORT=3001

# Frontend origin for JWT cookie (set to https:// URL for VPS deployments)
FRONTEND_ORIGIN=http://localhost:3001

# Set to true if using HTTPS (e.g., behind a reverse proxy with TLS)
COOKIE_SECURE=false

# Backend database directory (inside container)
DB_DIRECTORY=/data

# Backend port (internal only, not exposed to host)
PORT=3000

# Backend listen host
DEV_SERVER_URL=0.0.0.0

# Frontend URL (for backend to know where the frontend is)
FE_SERVER_URL=http://localhost:3001

# Path to migration files in docker volume
MIGRATIONS_PATH=/app/dist-be/backend/server/shared/migrations

# Vite API URL (only needed when running outside Docker)
# VITE_API_URL=http://localhost:3000
