# NodeDR Invoice — Environment Variables
# Copy this file to .env and adjust values as needed.

# Port the frontend is exposed on (default: 3001)
HOST_PORT=3001

# Frontend origin allowed to call the API and receive the session cookie
# (set to your https:// URL for VPS/internet-facing deployments)
FRONTEND_ORIGIN=http://localhost:3001

# Set to true once this is served over HTTPS (e.g. behind a reverse proxy
# with TLS, or nginx's own TLS termination). Required for the session
# cookie's Secure flag and for HSTS — leave false only for local/LAN use.
COOKIE_SECURE=false

# Session signing secret. If unset, one is generated on first boot and
# persisted to <DB_DIRECTORY>/.session_secret — set this explicitly if you
# want sessions to survive the container/volume being recreated.
# SESSION_SECRET=

# Backend database directory (inside container)
DB_DIRECTORY=/data

# Backend port (internal only, not exposed to host)
PORT=3000

# Backend listen host
DEV_SERVER_URL=0.0.0.0

# Frontend URL (for backend to know where the frontend is)
FE_SERVER_URL=http://localhost:3001

# Path to migration files in docker volume
MIGRATIONS_PATH=/app/dist-be/backend/server/shared/migrations

# Vite API URL (only needed when running outside Docker)
# VITE_API_URL=http://localhost:3000

# --- MCP server (optional) ---
# Run `npm run mcp` to start a Model Context Protocol server that exposes
# clients/items/invoices/US-sales-tax as tools for AI assistants (full
# read/write). It connects directly to an existing, already-migrated
# database file — create/open it in the app first, then:
#   1. POST /api/auth/setup (first run) or /api/auth/login to get a session
#      cookie, then POST /api/auth/api-keys with that cookie to mint a key.
#      (There is no API-key management screen in the UI yet — use curl/the
#      API directly for now.)
#   2. Set the vars below and run `npm run mcp`.
# NODEDR_API_KEY=ndr_...
# DB_DIRECTORY=data
# DB_FILE=mydata.db
