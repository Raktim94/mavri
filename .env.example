# Mavri — environment variables for docker compose (copy to .env)

# Port the app is exposed on (default: 3001)
HOST_PORT=3001

# Set to true once this is served over HTTPS (reverse proxy with TLS, Cloudflare
# Tunnel). Required for the session cookie's Secure flag and for HSTS — leave
# false only for local/LAN use.
COOKIE_SECURE=false

# How many reverse proxies sit in front of the app: 0 when clients connect
# directly, 1 behind nginx, Caddy or a Cloudflare Tunnel (so rate limits see the
# real client address).
TRUST_PROXY=0

# Key that protects e-commerce webhook secrets (32+ characters, or 64 hex
# characters). If unset, one is generated in the data volume.
# ENCRYPTION_KEY=

# --- Running the Go server without Docker (see rewrite/README.md) ---
# DEFAULT_DATABASE=invoice.db   # database file inside DB_DIRECTORY, opened or created on start
# DB_DIRECTORY=data
# PORT=3000
# FRONTEND_DIR=dist-fe          # serve the built web app from the same port
# FRONTEND_ORIGIN=http://127.0.0.1:5173   # only when the web app runs on another origin (Vite dev)

# --- MCP server (optional, for AI assistants) ---
# Build/run: cd rewrite && go run ./cmd/mcp
# Mint a key with POST /api/auth/api-keys while signed in, then:
# NODEDR_API_KEY=ndr_...
# DB_DIRECTORY=data
# DB_FILE=invoice.db
